{
 "_nota": "Registro de piezas v1 (prototipo). nombre en español -> función existente. args = orden real de la función; o = opciones (español -> clave original); tiempos = parámetros que son momentos (@evento). No migra piezas: solo describe cómo llamarlas.",
 "cielo":        {"fn": "sky",       "args": ["t", "brillo"]},
 "colinas":      {"fn": "hills",     "args": ["y", "color", "altura", "frec", "fase", "x0", "x1"], "req": ["y", "color"]},
 "fogata":       {"fn": "fire",      "args": ["x", "y", "escala", "t", "semilla", "alfa"], "req": ["x", "y"], "def": {"escala": 1}},
 "luzFuego":     {"fn": "fireLight", "args": ["x", "y", "radio", "t", "alfa"], "req": ["x", "y", "radio"]},
 "chispasFuego": {"fn": "sparksUp",  "args": ["x", "y", "t", "n", "semilla"], "req": ["x", "y"]},
 "nieve":        {"fn": "snowfall",  "args": ["t", "n", "semilla", "alfa", "vel"]},
 "humano":       {"fn": "human",     "args": ["x", "y", "escala", "o"], "req": ["x", "y"], "def": {"escala": 1},
                  "o": {"brazo": "arm", "codo": "bend", "color": "col", "borde": "rim", "voltear": "flip"}},
 "bestia":       {"fn": "beast",     "args": ["x", "y", "escala", "morph", "o"], "req": ["x", "y"], "def": {"escala": 1, "morph": 0},
                  "o": {"voltear": "flip", "color": "col", "borde": "rim", "ojo": "eye", "paso": "ph", "cabeza": "head", "cola": "wag", "rot": "rot", "reloj": "t"}},
 "carne":        {"fn": "meat",      "args": ["x", "y", "escala", "rot"], "req": [], "def": {"escala": 1, "rot": 0}},
 "rect":         {"fn": "_rect",     "args": ["x", "y", "ancho", "alto", "color"], "req": ["x", "y", "ancho", "alto", "color"]},
 "degradado":    {"fn": "vgrad",     "args": ["y0", "y1", "color0", "color1", "x0", "ancho"], "req": ["y0", "y1", "color0", "color1"]},
 "fondoDegradado": {"fn": "bg",      "args": ["color0", "color1"], "req": ["color0", "color1"]},
 "resplandor":   {"fn": "glow",      "args": ["x", "y", "radio", "color", "alfa"], "req": ["x", "y", "radio", "color"]},
 "onda":         {"fn": "shock",     "args": ["x", "y", "t", "en", "color", "radio", "grosor", "dur"], "req": ["x", "y", "en", "color"], "tiempos": ["en"]},
 "chispas":      {"fn": "sparks",    "args": ["x", "y", "t", "en", "n", "color", "vel", "vida", "gravedad", "semilla"], "req": ["x", "y", "en"], "tiempos": ["en"]},
 "estallido":    {"fn": "burst",     "args": ["x", "y", "t", "en", "colores", "n", "vel", "vida", "tam", "semilla"], "req": ["x", "y", "en"], "tiempos": ["en"]},
 "texto":        {"fn": "mtext",     "args": ["texto", "x", "y", "tam", "color", "t", "en", "o"], "req": ["texto", "x", "y", "tam", "color", "en"], "tiempos": ["en", "sale"],
                  "o": {"ancho": "w", "alinear": "a", "dur": "d", "escalon": "stg", "sale": "out", "durSale": "od", "contorno": "stroke", "grosor": "sw", "sombra": "sh", "resalta": "hl", "colorResalta": "hc", "peso": "wt"}},
 "etiqueta":     {"fn": "tag",       "args": ["texto", "x", "y", "tam", "fondo", "color", "t", "en", "o"], "req": ["texto", "x", "y", "tam", "fondo", "color", "en"], "tiempos": ["en", "sale"],
                  "o": {"alinear": "a", "sale": "out", "contorno": "stroke", "radio": "r", "peso": "wt"}},
 "golpe":        {"fn": "slam",      "args": ["texto", "x", "y", "tam", "color", "t", "en", "o"], "req": ["texto", "x", "y", "tam", "color", "en"], "tiempos": ["en"],
                  "o": {"contorno": "st", "grosor": "sw", "sombra": "sh", "alfa": "al"}}
}
