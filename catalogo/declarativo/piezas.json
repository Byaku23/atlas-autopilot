 "raton": {"fn": "mouse", "args": ["x", "y", "escala", "o"], "req": ["x", "y"], "def": {"escala": 1}, "o": {"color": "col", "voltear": "flip", "paso": "ph"}, "anclas": {"hocico": ["17", "-5"]}, "andar": {"param": "paso", "vel": 40}}
